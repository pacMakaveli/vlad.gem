          <p class="text-xl text-gray-600">
            Beautiful charts. Juicy insights. Screenshot-worthy stats. Go nuts.
          </p>
        </div>
      </div>
    </div>

    <div class="mt-16 text-center">
      <%= link_to "Try It Now →", dashboard_path, class: "inline-block bg-purple-600 text-white px-12 py-5 rounded-full text-2xl font-bold hover:bg-purple-700 transition-all shadow-xl" %>
