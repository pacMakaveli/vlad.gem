<% content_for :title, "Vlad's Gem 💎 - Your Relationship, Visualized" %>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap');
  
  * {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
  }

  body > nav + div {
    padding: 0 !important;
  }

  @keyframes wiggle {
    0%, 100% { transform: rotate(-3deg); }
    50% { transform: rotate(3deg); }
  }

  @keyframes bounce-in {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
  }

  @keyframes slide-up {
    from { transform: translateY(40px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .emoji-float {
    animation: wiggle 2s ease-in-out infinite;
  }

  .pop-in {
    animation: bounce-in 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  .slide-up {
    animation: slide-up 0.8s ease-out forwards;
    opacity: 0;
  }

  .fun-gradient {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .data-card {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .data-card:hover {
    transform: translateY(-8px) rotate(-2deg);
  }

  .screenshot-frame {
    border: 8px solid #1a1a1a;
    border-radius: 32px;
    box-shadow: 0 40px 100px rgba(0,0,0,0.4);
  }
</style>

<!-- Hero - Fun & Playful -->
<div class="fun-gradient min-h-screen flex items-center justify-center relative overflow-hidden">
  <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,<svg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"10\" y=\"40\" font-size=\"40\">💎</text></svg>'); background-size: 120px;"></div>
  
  <div class="max-w-6xl mx-auto px-6 py-20 text-center relative z-10">
    <div class="mb-6">
      <span class="inline-block text-8xl emoji-float">💎</span>
    </div>
    
    <h1 class="text-6xl md:text-8xl font-black text-white mb-6 leading-tight pop-in">
      Your Relationship,<br/>
      <span class="text-yellow-300">Visualized</span>
    </h1>

    <p class="text-2xl md:text-3xl text-white/90 mb-4 font-medium slide-up" style="animation-delay: 0.2s;">
      Like Spotify Wrapped, but for your WhatsApp chats
    </p>

    <p class="text-xl md:text-2xl text-white/70 mb-12 max-w-3xl mx-auto slide-up" style="animation-delay: 0.3s;">
      Upload. Analyze. Orgasm on data. 📊✨
    </p>

    <%= link_to dashboard_path, class: "inline-block bg-white text-purple-600 px-12 py-5 rounded-full text-2xl font-bold hover:scale-110 transition-transform shadow-2xl slide-up", style: "animation-delay: 0.4s;" do %>
      Start Your Journey →
    <% end %>

    <p class="mt-6 text-white/60 text-sm slide-up" style="animation-delay: 0.5s;">
      Free forever • No signup • 2 mins setup
    </p>
  </div>
</div>

<!-- What You'll Discover -->
<div class="bg-gray-50 py-24">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-5xl md:text-7xl font-black text-center mb-4">
      What You'll Discover 🔍
    </h2>
    <p class="text-xl text-center text-gray-600 mb-16">
      Turn thousands of messages into beautiful insights
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Mood Shifts -->
      <div class="data-card bg-gradient-to-br from-pink-500 to-rose-500 rounded-3xl p-8 text-white">
        <div class="text-6xl mb-4">😊😢😍</div>
        <h3 class="text-3xl font-bold mb-3">Mood Shifts</h3>
        <p class="text-white/90 text-lg">
          Watch emotions evolve over time. See the exact moment things got weird.
        </p>
      </div>

      <!-- Life Chapters -->
      <div class="data-card bg-gradient-to-br from-purple-500 to-indigo-500 rounded-3xl p-8 text-white">
        <div class="text-6xl mb-4">📖</div>
        <h3 class="text-3xl font-bold mb-3">Life Chapters</h3>
        <p class="text-white/90 text-lg">
          AI detects phases: honeymoon, crisis, comeback. Your relationship's story arc.
        </p>
      </div>

      <!-- Emoji Madness -->
      <div class="data-card bg-gradient-to-br from-yellow-400 to-orange-500 rounded-3xl p-8 text-white">
        <div class="text-6xl mb-4">🤣🔥💀</div>
        <h3 class="text-3xl font-bold mb-3">Emoji Analysis</h3>
        <p class="text-white/90 text-lg">
          Most used emoji? Favorite GIF? We count EVERYTHING.
        </p>
      </div>

      <!-- Response Patterns -->
      <div class="data-card bg-gradient-to-br from-blue-500 to-cyan-500 rounded-3xl p-8 text-white">
        <div class="text-6xl mb-4">⏱️</div>
        <h3 class="text-3xl font-bold mb-3">Response Times</h3>
        <p class="text-white/90 text-lg">
          Who leaves who on read? How fast do you reply? The tea is HOT.
        </p>
      </div>

      <!-- Activity Patterns -->
      <div class="data-card bg-gradient-to-br from-green-500 to-emerald-500 rounded-3xl p-8 text-white">
        <div class="text-6xl mb-4">🌙☀️</div>
        <h3 class="text-3xl font-bold mb-3">When You Chat</h3>
        <p class="text-white/90 text-lg">
          3am texts? Lunchtime conversations? Heatmaps show your rhythm.
        </p>
      </div>

      <!-- Message Volume -->
      <div class="data-card bg-gradient-to-br from-red-500 to-pink-500 rounded-3xl p-8 text-white">
        <div class="text-6xl mb-4">📈</div>
        <h3 class="text-3xl font-bold mb-3">The Numbers</h3>
        <p class="text-white/90 text-lg">
          100K messages analyzed. Every. Single. Word. Counted.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- How It Works - Super Simple -->
<div class="bg-white py-24">
