    <!-- Badge -->
    <div class="inline-block mb-8 scroll-reveal revealed">
      <div class="glass px-6 py-3 rounded-full text-white text-sm font-semibold border border-white/20">
        <span class="inline-block w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>
        Revolutionizing Relationship Analytics
      </div>
    </div>

    <!-- Main heading with dramatic typography -->
    <h1 class="scroll-reveal revealed" style="animation-delay: 0.1s;">
      <div class="text-white/90 text-xl md:text-2xl font-light mb-4 tracking-wide">
        INTRODUCING
      </div>
      <div class="text-7xl md:text-9xl font-black text-white mb-6 leading-none tracking-tight">
        Vlad's Gem
      </div>
      <div class="text-8xl md:text-9xl mb-8 scale-pulse">
        💎
      </div>
    </h1>

    <!-- Subheading -->
    <p class="text-2xl md:text-5xl font-bold text-white mb-6 leading-tight scroll-reveal revealed" style="animation-delay: 0.2s;">
      Your Relationships,<br/>
      <span class="text-yellow-300">Decoded</span>
    </p>

    <p class="text-lg md:text-2xl text-white/80 max-w-4xl mx-auto mb-12 font-light leading-relaxed scroll-reveal revealed" style="animation-delay: 0.3s;">
      Transform WhatsApp conversations into stunning visual insights.<br class="hidden md:block"/>
      Discover patterns, emotions, and stories hidden in every message.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-6 justify-center mb-16 scroll-reveal revealed" style="animation-delay: 0.4s;">
      <%= link_to dashboard_path, class: "magnetic-btn group px-12 py-6 bg-white text-purple-600 rounded-2xl text-xl font-bold inline-flex items-center justify-center gap-3 shadow-2xl" do %>
        <span>Start Free</span>
        <svg class="w-6 h-6 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      <% end %>

      <a href="#demo" class="glass px-12 py-6 rounded-2xl text-xl font-bold text-white inline-flex items-center justify-center gap-3 hover:bg-white/10 transition-all">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>Watch Demo</span>
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 max-w-5xl mx-auto scroll-reveal revealed" style="animation-delay: 0.5s;">
      <div class="glass p-6 rounded-2xl backdrop-blur-xl">
        <div class="text-5xl font-black text-white mb-2">100K+</div>
        <div class="text-white/70 text-sm uppercase tracking-wider">Messages Analyzed</div>
      </div>
      <div class="glass p-6 rounded-2xl backdrop-blur-xl">
        <div class="text-5xl font-black text-white mb-2">7</div>
        <div class="text-white/70 text-sm uppercase tracking-wider">Analytics Views</div>
      </div>
      <div class="glass p-6 rounded-2xl backdrop-blur-xl">
        <div class="text-5xl font-black text-white mb-2">100%</div>
        <div class="text-white/70 text-sm uppercase tracking-wider">Private</div>
      </div>
      <div class="glass p-6 rounded-2xl backdrop-blur-xl">
        <div class="text-5xl font-black text-white mb-2">&lt;60s</div>
        <div class="text-white/70 text-sm uppercase tracking-wider">Setup Time</div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 z-20">
    <div class="flex flex-col items-center gap-2 text-white/70 animate-bounce">
      <span class="text-sm uppercase tracking-wider">Scroll to explore</span>
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</div>

<!-- Bento Grid Section - Features -->
